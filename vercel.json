{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/about",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/oeru",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/the-chill-gallery",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/land-of-hope",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Chun%20Hee%20-%20Portfolio.dc.html"
    },
    {
      "source": "/process",
      "destination": "/process.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/cv",
      "destination": "/cv.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work",
      "destination": "/projects#side",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/projects#side",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/process.dc.html",
      "destination": "/process",
      "permanent": true
    },
    {
      "source": "/gameui-staging",
      "destination": "/the-chill-gallery",
      "permanent": true
    },
    {
      "source": "/gameui-staging.html",
      "destination": "/the-chill-gallery",
      "permanent": true
    }
  ]
}
